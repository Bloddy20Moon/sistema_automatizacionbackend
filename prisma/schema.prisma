datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  JEFE
  SUPERVISOR
  ASESOR
}

enum Queue {
  WSP_APP
  WSP_APP_RENO
  WSP_DIGITAL
  C2C_APP
  C2C_DIGITAL
}

enum TransactionType {
  PORTA
  LINEA_NUEVA
  ADICIONAL
  RENO
}

enum OpState {
  PENDIENTE
  ACTIVADO
  CAIDA
}

enum TargetType {
  USER
  QUEUE
}

model User {
  dni          String     @id
  name         String
  passwordHash String
  role         Role
  queue        Queue
  isActive     Boolean    @default(true)
  
  // Relations
  sales        Sale[]     @relation("AgentSales")
  auditLogs    AuditLog[] @relation("UserAudits")

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Sale {
  id                   String          @id @default(uuid())
  idOt                 String          // ID OT
  correlative          Int             @default(1) // Correlativo
  fechaVenta           DateTime        // Fecha de Venta
  estado               OpState         @default(PENDIENTE) // Estado
  tipoVenta            TransactionType // Tipo de Venta
  venta                String?         // Venta
  fechaActivacion      DateTime?       // Fecha de Activación
  campana              String          // Campaña
  dniCliente           String          // DNI del Cliente
  nombreCliente        String          // Nombre del Cliente
  numeroPortarRenovar  String?         // Número a Portar o Renovar
  tipoEntrega          String?         // Tipo de Entrega
  linkBotmaker         String?         // Link Botmaker
  dniAsesor            String          // DNI del Asesor
  agent                User            @relation("AgentSales", fields: [dniAsesor], references: [dni])
  nombreAsesor         String          // Nombre del Asesor
  reingreso            String?         // Reingreso
  resultadoEntrega     String?         // Resultado de Entrega
  estadoSiebel         String?         // Estado Siebel
  motivoSiebel         String?         // Motivo Siebel

  // Control y Auditoría
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  auditLogs            AuditLog[]      @relation("SaleAudits")

  // Clave Compuesta Única para Multilíneas
  @@unique([idOt, correlative])
}

model Meta {
  id         String     @id @default(uuid())
  targetId   String     // DNI del asesor o nombre de la Cola (ej. C2C_DIGITAL)
  targetType TargetType
  period     String     // Formato YYYY-MM
  quota      Int        // Cantidad de líneas meta
  
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@unique([targetId, period]) // Evita duplicidad de cuotas para el mismo periodo
}

model AuditLog {
  id            String   @id @default(uuid())
  saleId        String
  sale          Sale     @relation("SaleAudits", fields: [saleId], references: [id])
  modifiedField String
  oldValue      String?
  newValue      String?
  changedBy     String
  user          User     @relation("UserAudits", fields: [changedBy], references: [dni])
  timestamp     DateTime @default(now())
}

model CampaignSheet {
  id             String    @id @default(uuid())
  queue          Queue
  period         String
  spreadsheetId  String
  tabName        String    @default("VENTAS")
  isActive       Boolean   @default(true)
  lastSyncAt     DateTime?
  lastSyncStatus String?
  errorMessage   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([queue, period])
  @@index([isActive])
}
